<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prompt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pill_background"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/img_widget_sparkle"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_widget_sparkle"
        android:contentDescription="Antigravity" />

    <TextView
        android:id="@+id/tv_widget_prompt_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/img_widget_sparkle"
        android:layout_toStartOf="@id/btn_widget_voice"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Ask Antigravity..."
        android:textColor="#A0A0A5"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/btn_widget_voice"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="5dp"
        android:src="@drawable/ic_widget_mic"
        android:contentDescription="Voice Dictation" />

</RelativeLayout>
