                android:startY="26"
                android:endX="80"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#A855F7"/>
                <item android:offset="1.0" android:color="#8B5CF6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Floating Quantum Spark -->
    <path
        android:pathData="M54,42 L57,50 L65,53 L57,56 L54,64 L51,56 L43,53 L51,50 Z"
        android:fillColor="#FFFFFF" />

    <!-- Core Dot -->
    <path
